NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_PORT=4000
# Browser origins allowed to call the API (S14), comma-separated. Outside production any loopback origin
# (localhost / 127.0.0.1 / [::1], any port) is also allowed, so http://127.0.0.1:3000 works in development.
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/edurev
JWT_SECRET=revalanche_dev_jwt_secret_key_change_in_production
# Session length (S5). In production JWT_SECRET must be 32+ characters and not the default above, or the API won't start.
JWT_EXPIRES_IN=1d

# Set to true to refuse to start without MongoDB (instead of falling back to in-memory demo data)
REQUIRE_DB=false

# Production (NODE_ENV=production) never falls back to demo data. Set to true only for a deliberate demo without MongoDB.
ALLOW_DEMO_MODE=false

# Per-user write limits (S9). Defaults: bids 30/hour, earnings 30/hour, messages 60 per 10 min, photo uploads 20/hour.
# RATE_LIMIT_BIDS=30
# RATE_LIMIT_EARNINGS=30
# RATE_LIMIT_MESSAGES=60
# RATE_LIMIT_UPLOADS=20

# Email codes: sign-up verification and forgot password (docs/modules/email-codes.md).
# Without SMTP settings, development prints each email (with its code) in the API terminal.
# Free sending: a Gmail account with 2-Step Verification + an App password. Put the real values in your own .env only.
# SMTP_USER=revalanche.noreply@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="REVALANCHE <revalanche.noreply@gmail.com>"
# MAIL_TRANSPORT=console   # force console | memory | smtp (production must use smtp and refuses to start without SMTP_USER/SMTP_PASS)
# Per-device limits for the email-code endpoints. Defaults: 20 code requests an hour, 30 code checks per 15 minutes.
# OTP_SEND_RATE_LIMIT=20
# OTP_CHECK_RATE_LIMIT=30
